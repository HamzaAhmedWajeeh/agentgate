# A sovereign deployment: every model call stays on infrastructure the operator controls.
#
# Explicit settings only. There is no profile variable that sets others behind your back -- that is
# the invisible-read problem ADR 0009 exists to prevent -- so what this file says is everything it
# does, and startup validation refuses any combination that contradicts itself.
#
# Use:   cp env/sovereign.env .env     then fill in the lines marked REQUIRED.

# ---------------------------------------------------------------------------- lanes

# Sovereign by default. The policy gate can only narrow a request's lane, never widen it, so on this
# deployment nothing is ever sent to a third-party model provider, whatever it is classified as.
AGENTGATE_LANE=sovereign

# REQUIRED: your OpenAI-compatible endpoint. Ollama serves one here; vLLM at http://<host>:8000/v1.
AGENTGATE_SOVEREIGN_BASE_URL=http://localhost:11434/v1
# REQUIRED: the model it serves. No identifier ships here -- names change, and a guessed one fails at
# the first request rather than at startup.
AGENTGATE_SOVEREIGN_MODEL=replace-with-your-model
# A self-hosted endpoint costs nothing per token, so its price is zero -- but it must be stated: an
# unpriced model on a networked lane refuses to start.
AGENTGATE_MODEL_PRICES_USD_PER_MILLION={"replace-with-your-model":{"input":0.0,"output":0.0}}

# ---------------------------------------------------------------------------- the decider

# None. The decider is a cloud egress, and this deployment has no cloud lane, so configuring one is
# refused at startup: it could never run, and it would contradict the reason for this deployment.
AGENTGATE_DECIDER_BACKEND=none
AGENTGATE_DECIDER_MODE=shadow

# ---------------------------------------------------------------------------- effects

# The only sink: approved actions are recorded here and nothing real is performed. Any other value
# is refused at startup.
AGENTGATE_EFFECT_SINK=outbox
AGENTGATE_OUTBOX_PATH=data/outbox.jsonl

# ---------------------------------------------------------------------------- persistence

# SQLite, so a run paused at the approval gate survives the process that started it.
AGENTGATE_CHECKPOINTER=sqlite
AGENTGATE_SQLITE_PATH=data/agentgate.db
AGENTGATE_AUDIT_LOG_PATH=data/audit.jsonl

# ---------------------------------------------------------------------------- observability

# OTLP to a collector inside your own network: spans carry prompt and document content, and on a
# sovereign deployment they stay where the rest of it does. ADR 0008.
AGENTGATE_TRACING_BACKEND=otlp
# REQUIRED: your collector.
AGENTGATE_OTEL_EXPORTER_ENDPOINT=http://localhost:4318
