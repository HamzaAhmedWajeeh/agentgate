# A hybrid deployment: public requests may use a cloud model; restricted ones stay on the
# operator's own endpoint; a decider assesses cloud-routed drafts in shadow mode.
#
# Explicit settings only. There is no profile variable that sets others behind your back -- that is
# the invisible-read problem ADR 0009 exists to prevent -- so what this file says is everything it
# does, and startup validation refuses any combination that contradicts itself.
#
# Use:   cp env/hybrid.env .env     then fill in the lines marked REQUIRED. Secrets are left blank
# on purpose and go in your environment, never in a committed file.

# ---------------------------------------------------------------------------- lanes

# Cloud by default, with a sovereign endpoint the policy gate routes restricted requests to.
# Classification and retrieval run on the most contained lane -- the sovereign one here -- so a
# restricted request reaches no cloud provider through chat or retrieval (ADR 0004 items 14, 17).
AGENTGATE_LANE=cloud

# REQUIRED: OPENAI_API_KEY in your environment.
# OPENAI_API_KEY=
# REQUIRED: model identifiers from `make models`. None ship here.
AGENTGATE_CLOUD_CAPABLE_MODEL=replace-with-cloud-model
AGENTGATE_CLOUD_CHEAP_MODEL=replace-with-cloud-model

# REQUIRED: your OpenAI-compatible endpoint and the model it serves.
AGENTGATE_SOVEREIGN_BASE_URL=http://localhost:11434/v1
AGENTGATE_SOVEREIGN_MODEL=replace-with-your-model

# REQUIRED: a price for every model this deployment can reach -- read the cloud prices from your
# provider and note the date. The Jev price is TypeSafe's, read 2026-09-28 for jev-1.13.0: $0.042 per
# million input tokens, output free.
AGENTGATE_MODEL_PRICES_USD_PER_MILLION={"replace-with-cloud-model":{"input":0.0,"output":0.0},"replace-with-your-model":{"input":0.0,"output":0.0},"jev-1.13.0":{"input":0.042,"output":0.0}}

# ---------------------------------------------------------------------------- the decider

# Jev, in shadow mode. It assesses cloud-routed drafts from structured facts -- never the draft --
# and its verdict is recorded beside the human's decision and never acted on. A restricted request
# is never sent to it. Enforce mode needs thresholds measured from shadow-mode agreement, and none
# have been measured, so none are set here. docs/adr/0012.
AGENTGATE_DECIDER_BACKEND=jev
AGENTGATE_DECIDER_MODE=shadow
# REQUIRED: AGENTGATE_JEV_API_KEY (or TYPESAFE_API_KEY) in your environment.
# AGENTGATE_JEV_API_KEY=
AGENTGATE_JEV_BASE_URL=https://api.typesafe.ai/v1
AGENTGATE_JEV_MODEL=jev-1.13.0

# ---------------------------------------------------------------------------- effects

# The only sink: approved actions are recorded here and nothing real is performed. Any other value
# is refused at startup.
AGENTGATE_EFFECT_SINK=outbox
AGENTGATE_OUTBOX_PATH=data/outbox.jsonl

# ---------------------------------------------------------------------------- persistence

AGENTGATE_CHECKPOINTER=sqlite
AGENTGATE_SQLITE_PATH=data/agentgate.db
AGENTGATE_AUDIT_LOG_PATH=data/audit.jsonl

# ---------------------------------------------------------------------------- observability

AGENTGATE_TRACING_BACKEND=none
