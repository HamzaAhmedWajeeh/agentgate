# agentgate configuration
#
# Copy to .env and edit. Every variable below is read by src/agentgate/config.py; nothing
# else configures this system. Values shown are the defaults unless marked otherwise.
#
# As shipped, this file runs the system on the fake lane: deterministic, offline, and free.
# Switch to a real provider in the "cloud lane" section below.
#
# A misspelled AGENTGATE_* variable is a startup error, not a silent no-op.


# ---------------------------------------------------------------------------- application

# local | ci | docker
AGENTGATE_ENVIRONMENT=local
AGENTGATE_SERVICE_NAME=agentgate

# DEBUG | INFO | WARNING | ERROR
AGENTGATE_LOG_LEVEL=INFO

# JSON logs to stdout. Set false for human-readable console output while developing.
AGENTGATE_LOG_JSON=true


# ---------------------------------------------------------------------------- lane

# cloud | sovereign | fake
#
#   fake       deterministic scripted model. No network, no cost. Used by the test suite.
#   cloud      OpenAI, two tiers. Requires a key and two model identifiers.
#   sovereign  any OpenAI-compatible endpoint you control. Where restricted data is routed.
#
# This is the *default* lane. A request the classifier marks restricted is routed to the
# sovereign lane regardless of what is set here -- the policy gate overrides the default,
# never the other way around.
AGENTGATE_LANE=fake

# Determinism is the default. Raise only if you have a reason and have read the eval impact.
AGENTGATE_TEMPERATURE=0.0

AGENTGATE_REQUEST_TIMEOUT_SECONDS=30.0

# Retries per model call, on top of the fallback chain. 0-5.
AGENTGATE_MAX_RETRIES=2


# ---------------------------------------------------------------------------- cloud lane

# Required when AGENTGATE_LANE=cloud. The unprefixed OPENAI_API_KEY is also accepted, so an
# existing shell export works without duplication.
# OPENAI_API_KEY=sk-replace-me

# Optional. Point at an OpenAI-compatible gateway or proxy sitting in front of the cloud lane.
# AGENTGATE_OPENAI_BASE_URL=https://api.openai.com/v1

# Required when AGENTGATE_LANE=cloud. No defaults are shipped on purpose: a hardcoded model
# name that has since been retired fails at request time instead of at startup, and which
# models a given key can actually reach is not something this repo should guess.
#
# List what your key can reach:  make models
# (It cannot order by cost. The models endpoint exposes no pricing at all.)
#
#   CAPABLE  final synthesis only
#   CHEAP    routing, classification, and every other call
#
# SET BOTH TO THE SAME CHEAP SMALL MODEL. The two-tier split exists because the policy router
# deciding which tier may see the data is the point of this system -- not because the capable
# tier has to be expensive. Pointing CAPABLE at a costlier model is a deliberate edit you make
# when you want it, never something that happens because you left a default alone.
# AGENTGATE_CLOUD_CAPABLE_MODEL=
# AGENTGATE_CLOUD_CHEAP_MODEL=

# Embedding model for the retrieval corpus. Required only when indexing against a real lane.
# AGENTGATE_EMBEDDING_MODEL=


# ---------------------------------------------------------------------------- sovereign lane

# Required when AGENTGATE_LANE=sovereign. Any OpenAI-compatible server:
#
#   Ollama   http://localhost:11434/v1
#   vLLM     http://localhost:8000/v1
#
# From inside the Docker Compose stack, a server on the host is reachable at
# http://host.docker.internal:11434/v1 rather than localhost.
# AGENTGATE_SOVEREIGN_BASE_URL=http://localhost:11434/v1
# AGENTGATE_SOVEREIGN_MODEL=

# Most self-hosted servers ignore the key but reject a missing Authorization header.
# AGENTGATE_SOVEREIGN_API_KEY=not-required


# ---------------------------------------------------------------------------- budget gates

# Supervisor hand-offs before the budget guard forces finalisation. This is the policy limit.
AGENTGATE_MAX_ITERATIONS=8

# MEASURED, not guessed. `make measure` runs three representative requests through the full
# graph on the fake lane and totals the usage every model call reports.
#
#   a short public request          206 tokens
#   an involved internal request    236 tokens
#   a restricted request            237 tokens   <- heaviest
#
# Set at 10x the heaviest run: 237 * 10 = 2370. The multiple leaves room for a request several
# times larger than the sample without leaving room for a runaway, which is the whole point --
# a ceiling nothing ever approaches is decoration.
#
# RE-DERIVE AT THE END OF PHASE 4. The graph currently makes one model call per run. Research
# fan-out and drafting will multiply that severalfold, and this number will reject every run
# until it is measured again.
AGENTGATE_MAX_TOTAL_TOKENS=2370

# Hard stops, not warnings. Crossing either aborts the graph and records an audit event.
#   MAX_SPEND_USD          one run
#   MAX_SESSION_SPEND_USD  every run in this process, together. Bounds a loop of cheap runs,
#                          which no per-run ceiling can catch.
#
# DERIVED from the token ceiling above, priced at the table below rather than chosen because
# it looked small. The 2370-token budget splits 2040 input / 330 output, which at $0.10 and
# $0.40 per million comes to $0.000336. Rounded up to $0.0005 so rounding alone cannot trip it.
#
# The session ceiling is ten runs at that price. Adjust the multiple, not the arithmetic.
#
# These are small because the graph is small. They move with the token ceiling every time it
# is re-derived, and with the price table every time it changes.
AGENTGATE_MAX_SPEND_USD=0.0005
AGENTGATE_MAX_SESSION_SPEND_USD=0.005

# How far the live suite may exceed its pre-run estimate before aborting. The estimate is a
# guess made before the run; this is the part that actually stops something. Must exceed 1.0.
AGENTGATE_LIVE_SPEND_TOLERANCE=3.0


# ------------------------------------------------------------------------------- live suite
#
# The live suite is accounted separately from a run, because it is not one. A run is a single
# request through the graph, and MAX_TOTAL_TOKENS above exists to catch a runaway inside it.
# The suite is several independent cases sharing one ledger so the total is visible to the
# gatekeeper. Charged against the run ceiling it trips for being a suite -- a budget failure
# where nothing is wrong, whose obvious remedy is to raise the run ceiling, which weakens the
# guard that was working. So it gets its own ceilings, on their own basis.

# DERIVED, not guessed. `scripts/run_live.py` estimates the suite at 15 calls of 400 input and
# 150 output apiece: 8,250 tokens. At the 3.0 tolerance above, 8250 * 3 = 24750.
#
# That is the same basis as the dollar abort the gatekeeper already computes and prints -- the
# same bound, in the other unit. A test recomputes this from those constants, so changing the
# suite without re-deriving the ceiling fails the build instead of leaving a number describing
# a suite that no longer exists.
#
# The estimate is held to account by observation: `make test-live` prints estimated against
# actual for both tokens and dollars. If the ratio sits far from 1.0, correct the constants at
# the top of the script and re-derive this -- do not widen the tolerance.
AGENTGATE_MAX_LIVE_SUITE_TOKENS=24750

# DERIVED from the token ceiling above, priced the same way MAX_SPEND_USD is: 18,000 input and
# 6,750 output at $0.10 and $0.40 per million comes to $0.0045, rounded up to $0.005 so
# rounding alone cannot trip it.
AGENTGATE_MAX_LIVE_SUITE_SPEND_USD=0.005

# Set by `scripts/run_live.py` on the subprocess it launches, not by hand. Both are declared
# settings rather than loose environment variables because the unknown-variable guard rejects
# every unrecognised AGENTGATE_* name -- including, before these existed, the two the
# gatekeeper set itself, which made `make test-live` fail at startup every time.
#
#   LIVE_SPEND_LEDGER     where the suite writes what it spent, for the gatekeeper to read back
#   LIVE_SPEND_ABORT_USD  the estimate the operator was shown times the tolerance; tightens the
#                         suite ceiling above, so the abort is the figure they consented to
# AGENTGATE_LIVE_SPEND_LEDGER=data/live-spend.json
# AGENTGATE_LIVE_SPEND_ABORT_USD=0.0075

# Output ceilings per class of call. Tight where the answer is a label or a route, generous
# only where the answer is the deliverable. A single global cap would have to be sized for
# synthesis, making every cheap call carry a synthesis-sized worst case.
AGENTGATE_MAX_TOKENS_ROUTING=128
AGENTGATE_MAX_TOKENS_CLASSIFICATION=256
AGENTGATE_MAX_TOKENS_RESEARCH=1024
AGENTGATE_MAX_TOKENS_SYNTHESIS=4096
AGENTGATE_MAX_TOKENS_REPAIR=512

# Per-model prices in USD per million tokens, as JSON. Required for any lane that reaches the
# network: without a price the spend guard cannot account, and an unpriced model would look
# free, leaving the ceiling permanently uncrossed while real money was spent. Startup fails
# rather than assuming zero.
#
# No prices ship as defaults and no model identifiers appear here. Prices change, this repo
# does not fetch them, and a stale number committed to a file is worse than an absent one
# because it looks authoritative. Fill this in yourself:
#
#   1. `make models` lists what your key can reach. It cannot sort by price: the API
#      exposes none, and inferring cost from a model's name is guesswork.
#   2. Read the current per-million input and output prices from your provider's pricing page.
#   3. Paste them below, and note the date you checked so the next reader knows the vintage.
#
# Format, with the model identifiers replaced by the ones from step 1:
#
#   AGENTGATE_MODEL_PRICES_USD_PER_MILLION={"<cheap-model-id>":{"input":0.00,"output":0.00}}
#
# Checked against the provider pricing page on: <date you filled this in>
# AGENTGATE_MODEL_PRICES_USD_PER_MILLION={}

# LangGraph's own super-step ceiling, and only a backstop: it must exceed MAX_ITERATIONS so
# the budget guard trips first and stops the run cleanly. Hitting this one means a bug.
AGENTGATE_RECURSION_LIMIT=40


# ---------------------------------------------------------------------------- persistence

# memory | sqlite | postgres
#
# Thread checkpoints -- the state of one conversation, resumable after a crash.
#   memory    tests. Nothing survives the process.
#   sqlite    local single-process runs.
#   postgres  the Compose stack.
AGENTGATE_CHECKPOINTER=memory
AGENTGATE_SQLITE_PATH=data/agentgate.db

# Required when CHECKPOINTER or STORE_BACKEND is postgres.
# AGENTGATE_POSTGRES_DSN=postgresql://agentgate:agentgate@localhost:5432/agentgate

# memory | postgres
#
# Long-term memory, namespaced per user. Deliberately separate from checkpoints: a checkpoint
# is one thread's state, the store holds durable preferences that outlive every thread.
AGENTGATE_STORE_BACKEND=memory


# ---------------------------------------------------------------------------- retrieval

AGENTGATE_CORPUS_PATH=corpus

# memory | qdrant
#
# memory is the default path: dense search, no service to run, works in CI. qdrant is an
# optional Compose profile for anyone who wants the hybrid-search story.
AGENTGATE_VECTOR_BACKEND=memory
# AGENTGATE_QDRANT_URL=http://localhost:6333

AGENTGATE_RETRIEVAL_TOP_K=4


# ---------------------------------------------------------------------------- audit

# Append-only. Separate from application logs, and never rotated by the application itself.
AGENTGATE_AUDIT_LOG_PATH=data/audit.jsonl


# ---------------------------------------------------------------------------- api

# 0.0.0.0 inside a container; leave as loopback when running on a workstation.
AGENTGATE_API_HOST=127.0.0.1
AGENTGATE_API_PORT=8000


# ---------------------------------------------------------------------------- observability

# none | langsmith | otlp
#
# OpenTelemetry is the instrumentation in every case; this selects only the exporter behind
# it. The environments this runtime targets treat prompt and document content as regulated
# data, so where traces land is a deployment decision, not a default.
#
#   none       off. The process still logs structurally. Nothing leaves it.
#   langsmith  managed backend. Correct when the data is allowed to leave the boundary.
#   otlp       any OTLP collector, including one inside your own network.
#
# A backend selected without its destination is a startup error: spans dropped on the floor
# while the operator believes tracing is on is worse than tracing being off.
AGENTGATE_TRACING_BACKEND=none

# Required when AGENTGATE_TRACING_BACKEND=otlp.
# AGENTGATE_OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# Required when AGENTGATE_TRACING_BACKEND=langsmith.
# AGENTGATE_LANGSMITH_API_KEY=
# AGENTGATE_LANGSMITH_PROJECT=agentgate

# Serves /metrics for Prometheus.
AGENTGATE_METRICS_ENABLED=true
