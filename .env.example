# agentgate configuration
#
# Copy to .env and edit. Every variable below is read by src/agentgate/config.py; nothing
# else configures this system. Values shown are the defaults unless marked otherwise.
#
# As shipped, this file runs the system on the fake lane: deterministic, offline, and free.
# Switch to a real provider in the "cloud lane" section below.
#
# A misspelled AGENTGATE_* variable is a startup error, not a silent no-op.


# ---------------------------------------------------------------------------- application

# local | ci | docker
AGENTGATE_ENVIRONMENT=local
AGENTGATE_SERVICE_NAME=agentgate

# DEBUG | INFO | WARNING | ERROR
AGENTGATE_LOG_LEVEL=INFO

# JSON logs to stdout. Set false for human-readable console output while developing.
AGENTGATE_LOG_JSON=true


# ---------------------------------------------------------------------------- lane

# cloud | sovereign | fake
#
#   fake       deterministic scripted model. No network, no cost. Used by the test suite.
#   cloud      OpenAI, two tiers. Requires a key and two model identifiers.
#   sovereign  any OpenAI-compatible endpoint you control. Where restricted data is routed.
#
# This is the *default* lane. A request the classifier marks restricted is routed to the
# sovereign lane regardless of what is set here -- the policy gate overrides the default,
# never the other way around.
AGENTGATE_LANE=fake

# Determinism is the default. Raise only if you have a reason and have read the eval impact.
AGENTGATE_TEMPERATURE=0.0

AGENTGATE_REQUEST_TIMEOUT_SECONDS=30.0

# Retries per model call, on top of the fallback chain. 0-5.
AGENTGATE_MAX_RETRIES=2


# ---------------------------------------------------------------------------- cloud lane

# Required when AGENTGATE_LANE=cloud. The unprefixed OPENAI_API_KEY is also accepted, so an
# existing shell export works without duplication.
# OPENAI_API_KEY=sk-replace-me

# Optional. Point at an OpenAI-compatible gateway or proxy sitting in front of the cloud lane.
# AGENTGATE_OPENAI_BASE_URL=https://api.openai.com/v1

# Required when AGENTGATE_LANE=cloud. No defaults are shipped on purpose: a hardcoded model
# name that has since been retired fails at request time instead of at startup, and which
# models a given key can actually reach is not something this repo should guess.
#
# List what your key can reach, cheapest first:  make models
#
#   CAPABLE  final synthesis only
#   CHEAP    routing, classification, and every other call
# AGENTGATE_CLOUD_CAPABLE_MODEL=
# AGENTGATE_CLOUD_CHEAP_MODEL=

# Embedding model for the retrieval corpus. Required only when indexing against a real lane.
# AGENTGATE_EMBEDDING_MODEL=


# ---------------------------------------------------------------------------- sovereign lane

# Required when AGENTGATE_LANE=sovereign. Any OpenAI-compatible server:
#
#   Ollama   http://localhost:11434/v1
#   vLLM     http://localhost:8000/v1
#
# From inside the Docker Compose stack, a server on the host is reachable at
# http://host.docker.internal:11434/v1 rather than localhost.
# AGENTGATE_SOVEREIGN_BASE_URL=http://localhost:11434/v1
# AGENTGATE_SOVEREIGN_MODEL=

# Most self-hosted servers ignore the key but reject a missing Authorization header.
# AGENTGATE_SOVEREIGN_API_KEY=not-required


# ---------------------------------------------------------------------------- budget gates

# Supervisor hand-offs before the budget guard forces finalisation. This is the policy limit.
AGENTGATE_MAX_ITERATIONS=8

AGENTGATE_MAX_TOTAL_TOKENS=120000

# Hard ceiling. The run aborts when estimated spend crosses it.
AGENTGATE_MAX_SPEND_USD=0.50

# LangGraph's own super-step ceiling, and only a backstop: it must exceed MAX_ITERATIONS so
# the budget guard trips first and stops the run cleanly. Hitting this one means a bug.
AGENTGATE_RECURSION_LIMIT=40


# ---------------------------------------------------------------------------- persistence

# memory | sqlite | postgres
#
# Thread checkpoints -- the state of one conversation, resumable after a crash.
#   memory    tests. Nothing survives the process.
#   sqlite    local single-process runs.
#   postgres  the Compose stack.
AGENTGATE_CHECKPOINTER=memory
AGENTGATE_SQLITE_PATH=data/agentgate.db

# Required when CHECKPOINTER or STORE_BACKEND is postgres.
# AGENTGATE_POSTGRES_DSN=postgresql://agentgate:agentgate@localhost:5432/agentgate

# memory | postgres
#
# Long-term memory, namespaced per user. Deliberately separate from checkpoints: a checkpoint
# is one thread's state, the store holds durable preferences that outlive every thread.
AGENTGATE_STORE_BACKEND=memory


# ---------------------------------------------------------------------------- retrieval

AGENTGATE_CORPUS_PATH=corpus

# memory | qdrant
#
# memory is the default path: dense search, no service to run, works in CI. qdrant is an
# optional Compose profile for anyone who wants the hybrid-search story.
AGENTGATE_VECTOR_BACKEND=memory
# AGENTGATE_QDRANT_URL=http://localhost:6333

AGENTGATE_RETRIEVAL_TOP_K=4


# ---------------------------------------------------------------------------- audit

# Append-only. Separate from application logs, and never rotated by the application itself.
AGENTGATE_AUDIT_LOG_PATH=data/audit.jsonl


# ---------------------------------------------------------------------------- api

# 0.0.0.0 inside a container; leave as loopback when running on a workstation.
AGENTGATE_API_HOST=127.0.0.1
AGENTGATE_API_PORT=8000


# ---------------------------------------------------------------------------- observability

AGENTGATE_OTEL_ENABLED=false
# AGENTGATE_OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# Serves /metrics for Prometheus.
AGENTGATE_METRICS_ENABLED=true
